{
  "Routes": [
    {
      "DownstreamPathTemplate": "/ws/{everything}",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "core",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/core/ws/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "core",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/core/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tenant",
          "Port": 5036
        }
      ],
      "UpstreamPathTemplate": "/Tenant/{everything}",
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete",
        "OPTIONS"
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "cdn",
          "Port": 5110
        }
      ],
      "UpstreamPathTemplate": "/Cdn/{everything}",
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete",
        "OPTIONS"
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity",
          "Port": 5200
        }
      ],
      "DangerousAcceptAnyServerCertificateValidator": true,
      "UpstreamPathTemplate": "/Identity/{everything}",
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete",
        "OPTIONS"
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "flow",
          "Port": 5038
        }
      ],
      "UpstreamPathTemplate": "/Flow/{everything}",
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete",
        "OPTIONS"
      ]
    }

  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://*:5000"
  }
}
